{
  "expo": {
    "name": "AIMEDIX MEDS PARTNER",
    "slug": "aimedix-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "scheme": "aimedixpartner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aimedixmeds.partnerapp",
      "icon": "./assets/appicon.png"
    },
    "android": {
      "package": "com.aimedixmeds.partnerapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/appicon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/appicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/appicon-splash.png",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a89fe61-88ca-42c0-b33d-be50f62ae3e9"
      }
    },
    "owner": "harshpandeyxande"
  }
}
